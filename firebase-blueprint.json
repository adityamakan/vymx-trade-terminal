{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document containing authentication info and basic details.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "authType": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "lastLogin": { "type": "string" }
      },
      "required": ["uid", "name", "email", "authType"]
    },
    "UserLedger": {
      "title": "User Ledger",
      "description": "Document holding the user's balances, watchlist, portfolio, and transaction history.",
      "type": "object",
      "properties": {
        "virtualBalance": { "type": "number" },
        "watchlist": { "type": "array" },
        "portfolio": { "type": "array" },
        "transactions": { "type": "array" }
      },
      "required": ["virtualBalance", "watchlist", "portfolio", "transactions"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles."
    },
    "users/{userId}/ledger/data": {
      "schema": { "$ref": "#/entities/UserLedger" },
      "description": "Stores user portfolio, watchlist, and transactions."
    }
  }
}
