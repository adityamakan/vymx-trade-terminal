  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/server.ts",
    "build": "npm run lint && npm test && npm run build:artifacts",
    "start": "node dist-server/server.cjs",
    "clean": "rm -rf dist dist-server",
    "lint": "tsc --noEmit",
    "test": "tsx scripts/test-financial-analytics.ts",
