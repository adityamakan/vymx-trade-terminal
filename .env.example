# Optional server-side AI provider credentials. Never expose these in Vite/client variables.
GEMINI_API_KEY=""
# Optional compatibility name; used only when GEMINI_API_KEY is not set.
GOOGLE_API_KEY=""

# Optional verified data providers. Routes return an unavailable state when keys are absent.
FINNHUB_API_KEY=""
FRED_API_KEY=""

# Optional local server port (Render supplies PORT automatically).
PORT="5000"

# Optional public frontend setting for static previews. Must be a WebSocket URL, never a secret.
# Example: wss://vymx-trade-terminal-2.onrender.com/api/prices
VITE_WS_URL=""

# Server-side comma-separated exact origins or wildcard patterns allowed to open WebSockets.
# Example: https://your-site.netlify.app,https://deploy-preview-*--your-site.netlify.app
WEBSOCKET_ALLOWED_ORIGINS=""
