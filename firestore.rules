rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // The app stores one ledger document per Firebase user. No user can read
    // or write another user's portfolio, cash balance or transaction history.
    match /users/{userId}/ledger/data {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'virtualBalance',
          'watchlist',
          'portfolio',
          'transactions'
        ])
        && request.resource.data.virtualBalance is number
        && request.resource.data.virtualBalance >= 0
        && request.resource.data.watchlist is list
        && request.resource.data.watchlist.size() <= 100
        && request.resource.data.portfolio is list
        && request.resource.data.portfolio.size() <= 100
        && request.resource.data.transactions is list
        && request.resource.data.transactions.size() <= 1000;
      allow delete: if isOwner(userId);
    }

    // Timestamped portfolio observations are private to the owning Firebase user.
    // Prices are stored per instrument in provider-native quote currency; rules do
    // not permit cross-user access or arbitrary unbounded snapshot payloads.
    match /users/{userId}/portfolioSnapshots/{snapshotId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'id', 'capturedAt', 'cashBalance', 'positions', 'baseCurrency', 'fxRates', 'totalEquityUSD', 'source', 'currencyNormalization'
        ])
        && request.resource.data.id == snapshotId
        && request.resource.data.capturedAt is int
        && request.resource.data.cashBalance is number
        && request.resource.data.cashBalance >= 0
        && request.resource.data.positions is list
        && request.resource.data.positions.size() <= 100
        && request.resource.data.baseCurrency == 'USD'
        && request.resource.data.fxRates is map
        && request.resource.data.fxRates.keys().size() <= 30
        && (request.resource.data.totalEquityUSD == null || request.resource.data.totalEquityUSD is number)
        && request.resource.data.source == 'provider-quote-snapshot'
        && request.resource.data.currencyNormalization in ['provider-fx-to-usd', 'incomplete'];
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/portfolioIntradaySnapshots/{snapshotId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'id', 'capturedAt', 'cashBalance', 'positions', 'baseCurrency', 'fxRates',
          'totalEquityUSD', 'source', 'currencyNormalization'
        ])
        && request.resource.data.id == snapshotId
        && request.resource.data.capturedAt is int
        && request.resource.data.cashBalance is number
        && request.resource.data.cashBalance >= 0
        && request.resource.data.positions is list
        && request.resource.data.positions.size() <= 100
        && request.resource.data.baseCurrency == 'USD'
        && request.resource.data.fxRates is map
        && request.resource.data.fxRates.keys().size() <= 30
        && (request.resource.data.totalEquityUSD == null || request.resource.data.totalEquityUSD is number)
        && request.resource.data.source == 'provider-quote-snapshot'
        && request.resource.data.currencyNormalization in ['provider-fx-to-usd', 'incomplete'];
      allow delete: if isOwner(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
